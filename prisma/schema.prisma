// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
    provider = "prisma-client-js"
    output   = "../generated/prisma"
}

datasource db {
    provider = "sqlite"
    url      = env("DATABASE_URL")
}

/// A member of the warband, eligible to be sent for milk.
model Member {
    id            Int      @id @default(autoincrement())
    name          String
    favouriteMilk String?
    excuse        String?
    // Retired members keep their history but are never picked again.
    active        Boolean  @default(true)
    createdAt     DateTime @default(now())
    picks         Pick[]
}

/// One buyer per week. weekOf is the Sunday that starts the week (YYYY-MM-DD).
model Pick {
    id        Int      @id @default(autoincrement())
    weekOf    String   @unique
    decree    String
    memberId  Int
    member    Member   @relation(fields: [memberId], references: [id])
    createdAt DateTime @default(now())

    @@index([memberId])
}
